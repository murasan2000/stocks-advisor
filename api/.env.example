# ============================================================
# Stocks Advisor - 環境変数設定
# このファイルをコピーして .env として使用してください
#   cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# LLM プロバイダー設定
# ------------------------------------------------------------
# 利用するLLMプロバイダー: "local"（Ollama）または "bedrock"（Amazon Bedrock）
LLM_PROVIDER=local

# Ollama 設定（LLM_PROVIDER=local の場合）
# docker compose から起動する場合はホストのOllamaに接続するためこのURLを使用
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=gpt-oss:20b

# Amazon Bedrock 設定（LLM_PROVIDER=bedrock の場合）
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
BEDROCK_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ------------------------------------------------------------
# データベース設定
# ------------------------------------------------------------
# SQLiteデータベースのパス
# - db/ はリポジトリ直下の独立コンポーネント（将来 DB サービスに置換予定）
# - 開発時（api/ から起動）: ../db/stocks_advisor.db
# - docker compose: compose 側で /app/db/stocks_advisor.db に上書きされる
DB_PATH=../db/stocks_advisor.db

# ------------------------------------------------------------
# Langfuse 設定（オプション: LLMトレース・観測用）
# ------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ------------------------------------------------------------
# 外部API設定
# ------------------------------------------------------------
# "mock": 決定論的な合成データを使用（デフォルト・オフライン可）
# "live": スクリーナーが yfinance で実データを取得（APIキー不要）
#         ※ Yahoo へのアウトバウンド通信が必要。到達不可時は自動で合成へフォールバック
EXTERNAL_API_MODE=live
MOCK_DATA_DIR=../data/mock


# ------------------------------------------------------------
# 今後の開発で追加予定
